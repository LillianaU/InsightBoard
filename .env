# InsightBoard - Variables de entorno para desarrollo local

# Clave secreta de Django (obligatoria)
DJANGO_SECRET_KEY=django-secret-key-para-desarrollo-local-123456789

# Modo debug (True en desarrollo)
DEBUG=True

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightboard

# Configuracion de PostgreSQL
POSTGRES_DB=insightboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Dominios permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS_origenes permitidos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modulo de settings
DJANGO_SETTINGS_MODULE=config.settings.development
