# InsightBoard - Variables de entorno
# Copia este archivo como .env y edita los valores

# Clave secreta de Django (obligatoria)
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Modo debug (True en desarrollo, False en produccion)
DEBUG=True

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightboard

# Configuracion manual de PostgreSQL (si no usas DATABASE_URL)
POSTGRES_DB=insightboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Dominios permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS_origenes permitidos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modulo de settings
DJANGO_SETTINGS_MODULE=config.settings.development
